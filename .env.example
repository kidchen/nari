# Copy to .env and fill in. Never commit .env.
TELEGRAM_BOT_TOKEN=123456:replace-me
# Shared secret users type once: /start <INVITE_CODE> <profile_id>
BOT_INVITE_CODE=replace-with-a-long-random-string
# Google AI Studio key (free tier) for market news summaries. Optional.
GEMINI_API_KEY=
# Gmail that receives Redfin saved-search alerts. App password: myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
